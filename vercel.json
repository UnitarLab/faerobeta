{
  "cleanUrls": false,

  "rewrites": [
    { "source": "/@:handle([A-Za-z0-9_][A-Za-z0-9._]{1,29})", "destination": "/faero_v1_launch.html" },
    { "source": "/:handle((?!(?:admin|api|apps|assets|beta|icons|privacy|terms|www)$)(?![^/]*\\.(?:html?|js|css|json|xml|txt|webmanifest|png|jpe?g|gif|webp|svg|ico)$)[A-Za-z0-9_][A-Za-z0-9._]{1,29})", "destination": "/faero_v1_launch.html" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cache-Control", "value": "max-age=0, s-maxage=86400, stale-while-revalidate" }
      ]
    },
    {
      "source": "/faero_v1_launch.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
