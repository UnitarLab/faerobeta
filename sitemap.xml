<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only real destinations belong here — pages a person could land on cold and
  have it make sense. The ~20 legacy OS apps (notepad, emulator, painter…) are
  deliberately left out: they are window contents, not pages. Indexed on their
  own they appear as chrome-less fragments with no way back to Faero, which is
  a bad result for the searcher and dilutes the site for the crawler.

  Keep in sync with robots.txt. If the domain changes, it changes here, in
  robots.txt, in the og:/twitter: tags and canonical link of both shells, and
  in the Supabase redirect URL allowlist.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- The OS desktop. This is what faero.net/ actually serves. -->
  <url>
    <loc>https://faero.net/</loc>
    <lastmod>2026-08-13</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- The social app. Lives at an explicit .html path, not at /, because its
       Supabase auth redirects and PWA start_url are registered against it. -->
  <url>
    <loc>https://faero.net/faero_v1_launch.html</loc>
    <lastmod>2026-08-13</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Closed-beta waitlist. Still live and still linked from the desktop. -->
  <url>
    <loc>https://faero.net/beta</loc>
    <lastmod>2026-08-13</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <url>
    <loc>https://faero.net/privacy.html</loc>
    <lastmod>2026-08-13</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

  <url>
    <loc>https://faero.net/terms.html</loc>
    <lastmod>2026-08-13</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

</urlset>
